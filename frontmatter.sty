%% Thesis type.
\newcommand\thtype[1]{\def\@thtype{#1}}
%% Default thesis type.
\thtype{vubachelor}

%% Thesis title.
\newcommand\thtitle[1]{\def\@thtitle{#1}}
\thtitle{\thesistitle}

%% Student name.
\newcommand\thauthname[1]{\def\@thauthname{#1}}
\thauthname{\thauthor}

%% Student ID.
\newcommand\thauthid[1]{\def\@thauthid{#1}}
\thauthid{\thauthorid}

%% First supervisor.
\newcommand{\thsvfirst}[2]{%
  \def\@thsvfirstname{#1}%
  \def\@thsvfirsttitle{#2}}
\thsvfirst{}{}

%% Daily supervisor.
\newcommand{\thsdpt}[1]{\def\@thsdptname{#1}}
\thsdpt{}

%% Second reader.
